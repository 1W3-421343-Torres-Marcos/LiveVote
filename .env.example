# ==============================================================================
# LiveVote - Variables de entorno para DESARROLLO LOCAL (docker compose up)
# Copiar a .env para personalizar valores locales. Nunca usar estos valores en prod.
# ==============================================================================

# PostgreSQL - votes-service (dueño exclusivo)
POSTGRES_VOTES_DB=votes_db
POSTGRES_VOTES_USER=votes_user
POSTGRES_VOTES_PASSWORD=votes_dev_password

# PostgreSQL - results-service (dueño exclusivo)
POSTGRES_RESULTS_DB=results_db
POSTGRES_RESULTS_USER=results_user
POSTGRES_RESULTS_PASSWORD=results_dev_password

# RabbitMQ
RABBITMQ_USER=livevote
RABBITMQ_PASSWORD=livevote_dev_password
RABBITMQ_VHOST=/

# Seguridad JWT (HS256, mínimo 32 bytes; compartido entre votes-service y api-gateway)
JWT_SECRET=dev-only-jwt-secret-change-in-production-minimum-32-bytes
JWT_EXPIRATION_SECONDS=7200

# Perfil Spring activo
SPRING_PROFILES_ACTIVE=dev
