# ==============================================================================
# LiveVote - Plantilla de variables de entorno para PRODUCCION
# ==============================================================================
# INSTRUCCIONES:
# 1. Copiar este archivo a .env.prod en el servidor destino (NUNCA versionar .env.prod).
# 2. Completar TODAS las variables sin dejar valores vacios ni credenciales por defecto.
# 3. Generar secretos fuertes (minimo 32 bytes para JWT_SECRET), por ejemplo:
#      openssl rand -base64 48
# 4. Ajustar los limites de memoria JVM segun la RAM real del plan gratuito elegido.
# ==============================================================================

# PostgreSQL - votes-service (dueño exclusivo)
POSTGRES_VOTES_DB=votes_db
POSTGRES_VOTES_USER=votes_user
POSTGRES_VOTES_PASSWORD=

# PostgreSQL - results-service (dueño exclusivo)
POSTGRES_RESULTS_DB=results_db
POSTGRES_RESULTS_USER=results_user
POSTGRES_RESULTS_PASSWORD=

# RabbitMQ
RABBITMQ_USER=livevote
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# Seguridad JWT (HS256, minimo 32 bytes, generado con openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION_SECONDS=7200

# Perfil Spring activo
SPRING_PROFILES_ACTIVE=prod

# Versiones fijas de imagenes (versionado semantico, nunca usar latest)
APP_VERSION=0.8.0

# Binding HTTP del reverse proxy frontend (en --profile tls usar ej. 127.0.0.1:8088 para liberar :80 a Caddy)
PROD_HTTP_BIND=0.0.0.0:80

# Dominio publico / TLS (requerido al activar --profile tls)
PUBLIC_DOMAIN=

# Retencion local de backups pg_dump (dias)
RETENTION_DAYS=7

# Opciones de memoria JVM por contenedor via JAVA_TOOL_OPTIONS en Distroless (calibrado para 2 GB RAM)
VOTES_JAVA_OPTS=-XX:MaxRAMPercentage=60.0
RESULTS_JAVA_OPTS=-XX:MaxRAMPercentage=60.0
GATEWAY_JAVA_OPTS=-XX:MaxRAMPercentage=60.0
